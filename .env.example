# G.O.A.T Environment Configuration
# Copy this file to .env and customize for your environment

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_DEBUG=False

# External Tools Paths
BOWTIE2_PATH=/usr/bin/bowtie2
CUTADAPT_PATH=/usr/bin/cutadapt
SAMTOOLS_PATH=/usr/bin/samtools
HISAT2_PATH=/usr/bin/hisat2
UCSC_TOOLS_DIR=/usr/local/bin

# Processing Configuration
PROCESSING_THREADS=8
WORKER_POOL_SIZE=8

# Logging
LOG_LEVEL=INFO

# Optional: Custom data directory
# DATA_DIR=/path/to/data

# Optional: Custom mappers directory
# MAPPERS_DIR=/path/to/mappers
